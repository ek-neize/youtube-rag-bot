{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: ytbot",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "ytbot.py"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "justMyCode": false
    }
  ]
}
